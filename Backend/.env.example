# Sentinel-QA environment template. Copy to `.env` and fill in.
# `.env` is gitignored; this file is tracked.

# --------------------------------------------------------------------------- #
# Vertex AI (required by utils/llm.py)
# --------------------------------------------------------------------------- #
# Authentication uses Application Default Credentials (ADC), NOT an API key.
# Set up once with either:
#     gcloud auth application-default login
# or by setting GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
#
# These two are mandatory — the process will fail fast if unset.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1

# Optional: override the model id. Defaults to gemini-2.5-flash.
# SENTINEL_LLM_MODEL=gemini-2.5-flash

# --------------------------------------------------------------------------- #
# Vector store (optional — sensible defaults in vector_store.py)
# --------------------------------------------------------------------------- #
# CHROMA_PERSIST_DIR=./chroma_data
# CHROMA_COLLECTION_NAME=code_sources
# SENTINEL_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# --------------------------------------------------------------------------- #
# Cross-encoder reranker (optional — off by default)
# --------------------------------------------------------------------------- #
# When enabled, retrieval over-fetches from ChromaDB and rescores with a
# cross-encoder before returning top-K. Improves precision at the cost of
# a one-time ~600 MB model download and ~50–200 ms per query.
# SENTINEL_RERANKER_ENABLED=0
# SENTINEL_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# SENTINEL_RERANKER_OVERFETCH=3

# --------------------------------------------------------------------------- #
# GitHub sync daemon (optional — only needed when running database/github_sync.py)
# --------------------------------------------------------------------------- #
# GITHUB_REPO_URL=https://github.com/your-org/your-app.git
# REPO_CACHE_DIR=./repo_cache
# SYNC_INTERVAL_SECONDS=300

# --------------------------------------------------------------------------- #
# Executor safety cap (optional)
# --------------------------------------------------------------------------- #
# Max `_repeat` iterations per test. Override only if you know why.
# SENTINEL_REPEAT_CAP=2000
