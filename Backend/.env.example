# Sentinel-QA environment template. Copy to `.env` and fill in.
# `.env` is gitignored; this file is tracked.

# --------------------------------------------------------------------------- #
# Vertex AI (required by utils/llm.py)
# --------------------------------------------------------------------------- #
# Authentication uses Application Default Credentials (ADC), NOT an API key.
# Set up once with either:
#     gcloud auth application-default login
# or by setting GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
#
# These two are mandatory — the process will fail fast if unset.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1

# Optional: override the model id. Defaults to gemini-2.5-flash.
# SENTINEL_LLM_MODEL=gemini-2.5-flash

# --------------------------------------------------------------------------- #
# Vector store (optional — sensible defaults in vector_store.py)
# --------------------------------------------------------------------------- #
# CHROMA_PERSIST_DIR=./chroma_data
# CHROMA_COLLECTION_NAME=code_sources
# SENTINEL_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# Memory caps for the Jina embedder. Defaults are safe for 16 GB RAM
# laptops. Lower max-seq-length if you hit OOM on long code chunks;
# raise it on a GPU box with lots of VRAM for higher-quality embeddings
# of long files.
# SENTINEL_EMBED_MAX_SEQ=2048
# SENTINEL_EMBED_BATCH_SIZE=8

# --------------------------------------------------------------------------- #
# RAG retrieval mode — single knob that picks the right cost/precision tier.
# --------------------------------------------------------------------------- #
# Trades wall time for precision. Default is `naive`, which is plenty at
# demo-scale (<1 k chunks). Flip up as the corpus grows.
#
#   naive    : one ChromaDB query, top_k snippets, no reranker,
#              no multi-query expansion. ~0.3 s/call. Useful as a
#              smoke test. NOTE: leaves schema/frontend/api_client
#              retrieval buckets empty, which the Generator's coverage-
#              gap heuristics interpret as "retrieval missed context",
#              so naive mode surfaces FALSE-POSITIVE coverage gaps on
#              every requirement by design. Use for perf checks only.
#
#   standard : 5-bucket multi-query expansion (router / schema / model /
#              frontend / api_client). Reranker off. ~1–2 s/call.
#              DEFAULT. The tier whose assumptions match the rest of
#              the pipeline (labeled buckets, honest coverage gaps).
#
#   full     : 5-bucket multi-query + cross-encoder reranker. Currently
#              adds ~10 min/requirement on CPU because of a known
#              slowdown in the reranker path (under investigation). Use
#              for evaluation runs only until that's fixed.
#
# SENTINEL_RAG_MODE=standard

# --------------------------------------------------------------------------- #
# Cross-encoder reranker (legacy flag, only consulted by `full` mode; also
# respected if SENTINEL_RAG_MODE is unset, for backward compatibility).
# --------------------------------------------------------------------------- #
# When enabled, retrieval over-fetches from ChromaDB and rescores with a
# cross-encoder before returning top-K. One-time ~600 MB model download.
# Per-call cost is ~50–200 ms on GPU and 30–90 s on CPU.
# SENTINEL_RERANKER_ENABLED=0
# SENTINEL_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# SENTINEL_RERANKER_OVERFETCH=3

# --------------------------------------------------------------------------- #
# GitHub sync daemon (optional — only needed when running database/github_sync.py)
# --------------------------------------------------------------------------- #
# GITHUB_REPO_URL=https://github.com/your-org/your-app.git
# REPO_CACHE_DIR=./repo_cache
# SYNC_INTERVAL_SECONDS=300

# --------------------------------------------------------------------------- #
# Security+Compiler — live API + generated pytest (see docs/)
# --------------------------------------------------------------------------- #
# httpx targets this origin (no FastAPI TestClient). Required to *run* generated tests.
# SENTINEL_BASE_URL=http://localhost:8000
#
# JWT for generated pytest (GET /tasks/, etc.). Use the JSON `access_token` from POST /login
# or /register (not refresh_token). Paste raw JWT or full `Bearer eyJ...`.
# If the API returns 401 "Could not validate credentials", the JWT is rejected (expired,
# wrong signing secret vs the running server, or typo). Re-login and retry.
# Generated pytest loads Backend/.env via path from the test file (not CWD) with override=True
# so values here beat a stale SENTINEL_TEST_BEARER_TOKEN left in the shell. To clear shell:
#   Remove-Item Env:SENTINEL_TEST_BEARER_TOKEN -ErrorAction SilentlyContinue
# SENTINEL_TEST_BEARER_TOKEN=
#
# Root for materialized files (default: Backend/workspace). Entire tree is gitignored.
# SENTINEL_WORKSPACE_ROOT=./workspace
#
# Max TestCase rows emitted into a single test_sentinel_api_generated.py (after slice).
# SENTINEL_COMPILER_MAX_TESTS_PER_FILE=80
#
# SENTINEL_COMPILER_MAX_ADVERSARIAL=200   # max adversarial rows appended (default 200)
# SENTINEL_COMPILER_MAX_FILES=8           # reserved; single combined pytest file for now

# --------------------------------------------------------------------------- #
# Executor — run generated pytest (optional)
# --------------------------------------------------------------------------- #
# When Security+Compiler wrote paths in metadata, Executor subprocess-runs the
# latest .py with pytest --junitxml and maps results to ExecutionLog (no stub loop).
# SENTINEL_EXECUTOR_RUN_PYTEST=0   # fall back to per-TestCase runner= only
# SENTINEL_PYTEST_TIMEOUT_SEC=900

# --------------------------------------------------------------------------- #
# Executor safety cap (optional)
# --------------------------------------------------------------------------- #
# Max `_repeat` iterations per test. Override only if you know why.
# SENTINEL_REPEAT_CAP=2000
