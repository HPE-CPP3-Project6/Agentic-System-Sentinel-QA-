# Smart Task Manager – Environment Variables
# ------------------------------------------
# Copy this file to `.env` and populate with real values.
# NEVER commit the actual `.env` file to version control.

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_a_long_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Soft-Delete Undo Window ───────────────────────────────────────────────
SOFT_DELETE_UNDO_WINDOW_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
