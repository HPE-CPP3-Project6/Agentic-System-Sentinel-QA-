        "Adversarial test expected ANY of " + str(_accept)
        + " (attack neutralized), got "
        + str(response.status_code)
        + " — excerpt: "
        + response.text[:800]
    )
    {% elif tc.expected_status_code is not none %}
    assert response.status_code == {{ tc.expected_status_code }}, (
        "Expected status {{ tc.expected_status_code }}, got "
        + str(response.status_code)
        + " — excerpt: "
        + response.text[:800]
    )
