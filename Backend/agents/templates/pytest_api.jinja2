    {% else %}
    use_auth = {% if tc.use_auth %}True{% else %}False{% endif %}
    headers = _default_auth_headers() if use_auth else {}
    if use_auth and not headers:
        pytest.skip(
            "Authenticated test: set SENTINEL_TEST_BEARER_TOKEN (JWT) for GET /tasks/ etc.",
        )

    method = {{ tc.method | tojson }}
    path = {{ tc.path | tojson }}
    payload = {{ tc.payload_literal }}
    assert isinstance(payload, (dict, list)), "payload must be dict or list for httpx"

    m = method.upper()
    with httpx.Client(
        base_url=BASE_URL,
        timeout=120.0,
        follow_redirects=True,
        headers=headers,
    ) as client:
        if m == "GET":
            if not isinstance(payload, dict):
                pytest.skip("GET with non-dict payload is not generated for this harness")
            response = client.request("GET", path, params=payload)
        elif m in ("POST", "PUT", "PATCH", "DELETE"):
            is_form = False
            if isinstance(payload, dict):
                if payload.get("_content_type") == "application/x-www-form-urlencoded" or path == "/login":
                    is_form = True
            if is_form:
                form_data = {k: v for k, v in payload.items() if k != "_content_type"}
                response = client.request(m, path, data=form_data)
            else:
                response = client.request(m, path, json=payload)
        else:
            pytest.skip("Unsupported HTTP method: " + str(method))

    {% if tc.acceptable_status_codes %}
