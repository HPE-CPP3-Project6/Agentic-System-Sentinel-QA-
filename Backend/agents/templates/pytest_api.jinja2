BASE_URL = (os.environ.get("SENTINEL_BASE_URL") or "http://localhost:8000").rstrip("/")


_cached_token: str | None = None


def _get_fresh_token() -> str:
    global _cached_token
    if _cached_token is not None:
        return _cached_token

    # 1. Check environment/dotenv first
    raw = os.environ.get("SENTINEL_TEST_BEARER_TOKEN", "").strip()
    if len(raw) >= 2 and ((raw[0] == raw[-1] == '"') or (raw[0] == raw[-1] == "'")):
        raw = raw[1:-1].strip()
    if raw.lower().startswith("bearer "):
        raw = raw[7:].strip()

    email = os.environ.get("SENTINEL_TEST_USER_EMAIL", "sentinel-qa@example.com")
    password = os.environ.get("SENTINEL_TEST_USER_PASSWORD", "Sentinel-QA-Bootstrap-2026!")

    # 2. Try to dynamically register and login to get a fresh JWT
    try:
        with httpx.Client(base_url=BASE_URL, timeout=5.0, follow_redirects=True) as client:
            try:
                client.post("/register", json={"email": email, "password": password})
            except Exception:
                pass

            r = client.post(
                "/login",
                data={"username": email, "password": password},
                headers={"Content-Type": "application/x-www-form-urlencoded"},
            )
            if r.status_code == 200:
                token = r.json().get("access_token")
                if token:
                    _cached_token = token
                    return token
    except Exception:
        pass

    # 3. Fallback to raw token if dynamic fetch failed
    if raw:
        _cached_token = raw
        return raw
    return ""


def _default_auth_headers() -> dict[str, str]:
    token = _get_fresh_token()
    if not token:
        return {}
    return {"Authorization": "Bearer " + token}


# FastAPI / Pydantic error-envelope keys. These appear in EVERY structured
# error body (`{"detail":[{"loc":...,"msg":...,"type":...}]}`) so a forbidden
# assertion on them is always a test defect, not an app leak. Skipped as a
# last-line-of-defense even if a forbidden list slips past the Generator's
# _sanitize_forbidden_content (e.g. via a heal-cycle regeneration).
_FORBIDDEN_ENVELOPE_SKIP = {
    "detail", "loc", "msg", "type", "ctx", "input", "url", "errors",
}


def _assert_forbidden(text: str, forbidden: list[str]) -> None:
    lower = text.lower()
    for needle in forbidden:
        if not needle:
            continue
        if needle.strip().lower() in _FORBIDDEN_ENVELOPE_SKIP:
            continue  # framework envelope key — never a real leak
        if needle.lower() in lower:
            pytest.fail("Forbidden response fragment found: " + repr(needle))


def _resolve_path_placeholders(path: str, payload: dict) -> str:
    """Replace ``{task_id}`` in a path from payload keys when not workflow-captured."""
    if "{" not in path:
        return path
    tid = payload.get("task_id") or payload.get("id")
    if tid is not None:
        return path.replace("{task_id}", str(tid))
    return path


def _substitute_workflow_path(path: str, captured: dict[str, str]) -> str:
    """Fill ``{task_id}`` (and aliases) from prior workflow step captures."""
    import re

    def _repl(match: re.Match[str]) -> str:
        name = match.group(1)
        if name in captured:
            return captured[name]
        if name == "task_id" and "id" in captured:
            return captured["id"]
        return match.group(0)

    return re.sub(r"\{([a-zA-Z_][a-zA-Z0-9_]*)\}", _repl, path)


def _run_workflow_steps(
    client: httpx.Client,
    steps: list[dict],
    *,
    headers: dict[str, str],
    is_adversarial: bool,
) -> None:
    """Execute ordered HTTP steps for ``state_transition`` tests."""
    captured: dict[str, str] = {}
    for idx, step in enumerate(steps):
        method = str(step.get("method") or "GET").upper()
        raw_path = str(step.get("path") or "/")
        payload = step.get("input_data") or {}
        if not isinstance(payload, dict):
            pytest.fail(f"workflow step {idx + 1}: input_data must be a dict")
        if "{" in raw_path and "task_id" not in captured and "id" not in captured:
            pytest.skip(
                f"workflow step {idx + 1} needs a task id from an earlier "
                "capture_json_key step (POST create)",
            )
        path = _substitute_workflow_path(raw_path, captured)
        path = _resolve_path_placeholders(path, payload)
        if "{" in path:
            pytest.skip(
                f"workflow step {idx + 1}: unresolved path template {raw_path!r}",
            )
        payload = _maybe_randomise_email(
            payload, path=path, is_adversarial=is_adversarial
        )
        expected = int(step["expected_status_code"])
        m = method
        if m == "GET":
            response = client.request("GET", path, params=payload)
        elif m in ("POST", "PUT", "PATCH", "DELETE"):
            response = client.request(m, path, json=payload)
        else:
            pytest.fail("Unsupported workflow method: " + method)
        assert response.status_code == expected, (
            f"workflow step {idx + 1} {method} {path}: expected {expected}, "
            f"got {response.status_code} — {response.text[:500]}"
        )
        cap_key = step.get("capture_json_key")
        if cap_key:
            try:
                body = response.json()
            except Exception as exc:
                pytest.fail(
                    f"workflow step {idx + 1}: capture_json_key={cap_key!r} "
                    f"but response is not JSON: {exc}"
                )
            if not isinstance(body, dict):
                pytest.fail(
                    f"workflow step {idx + 1}: JSON missing key {cap_key!r}"
                )
            val = body.get(cap_key)
            if val is None and cap_key in ("task_id", "id"):
                val = body.get("id") or body.get("task_id")
            if val is None:
                pytest.fail(
                    f"workflow step {idx + 1}: JSON missing key {cap_key!r}"
                )
            captured[cap_key] = str(val)
            captured["task_id"] = captured[cap_key]
            captured["id"] = captured[cap_key]
        for key in step.get("expected_json_keys") or []:
            body = response.json()
            assert isinstance(body, dict) and key in body, (
                f"workflow step {idx + 1}: expected JSON key {key!r}"
            )


