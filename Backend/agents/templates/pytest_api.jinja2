from __future__ import annotations

import os
from pathlib import Path

import httpx
import pytest

try:
    from dotenv import load_dotenv

    # CWD varies (IDE vs terminal); shell may set a stale SENTINEL_TEST_BEARER_TOKEN
    # (load_dotenv default override=False would keep it). Load Backend/.env explicitly.
    _backend_root = Path(__file__).resolve().parents[3]
    load_dotenv(_backend_root / ".env", override=True)
except ImportError:
    pass

BASE_URL = (os.environ.get("SENTINEL_BASE_URL") or "http://localhost:8000").rstrip("/")


def _default_auth_headers() -> dict[str, str]:
    raw = os.environ.get("SENTINEL_TEST_BEARER_TOKEN", "").strip()
    if len(raw) >= 2 and ((raw[0] == raw[-1] == '"') or (raw[0] == raw[-1] == "'")):
        raw = raw[1:-1].strip()
    if not raw:
        return {}
    if raw.lower().startswith("bearer "):
        return {"Authorization": raw}
    return {"Authorization": "Bearer " + raw}


def _assert_forbidden(text: str, forbidden: list[str]) -> None:
    lower = text.lower()
    for needle in forbidden:
        if needle and needle.lower() in lower:
            pytest.fail("Forbidden response fragment found: " + repr(needle))


