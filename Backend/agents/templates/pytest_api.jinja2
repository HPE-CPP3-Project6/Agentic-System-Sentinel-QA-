    # rate-limit / brute-force ACs (REQ-002's "100 failed login attempts, no
    # lockout") actually exercise N iterations. Single-shot when repeat_count == 1.
    _repeat_n = {{ tc.repeat_count | default(1) }}
    _observed_statuses: list[int] = []
    _last_response_text: str = ""
    with httpx.Client(
        base_url=BASE_URL,
        timeout=120.0,
        follow_redirects=True,
        headers=headers,
    ) as client:
        for _iter in range(_repeat_n):
            if m == "GET":
                if not isinstance(payload, dict):
                    pytest.skip("GET with non-dict payload is not generated for this harness")
                response = client.request("GET", path, params=payload)
            elif m in ("POST", "PUT", "PATCH", "DELETE"):
                is_form = False
                if isinstance(payload, dict):
                    if payload.get("_content_type") == "application/x-www-form-urlencoded" or path == "/login":
                        is_form = True
                if is_form:
                    form_data = {k: v for k, v in payload.items() if k != "_content_type"}
