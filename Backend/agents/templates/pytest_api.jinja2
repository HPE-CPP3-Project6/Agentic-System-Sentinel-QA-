def _import_runtime_placeholders():
    """Locate Backend root (walk up until utils/placeholders.py exists)."""
    for ancestor in Path(__file__).resolve().parents:
        if (ancestor / "utils" / "placeholders.py").is_file():
            root = str(ancestor)
            if root not in sys.path:
                sys.path.insert(0, root)
            from utils.placeholders import inflate_runtime_placeholders
            return inflate_runtime_placeholders
    raise RuntimeError(
        "Sentinel pytest harness: could not import utils.placeholders "
        "(walked up from " + str(Path(__file__).resolve()) + ")",
    )


_inflate_runtime_placeholders = _import_runtime_placeholders()


