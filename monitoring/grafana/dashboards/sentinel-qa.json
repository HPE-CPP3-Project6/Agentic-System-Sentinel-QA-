{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Sentinel-QA",
  "uid": "sentinel-qa",
  "tags": ["sentinel", "sentinel-qa"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "price_per_1k",
        "label": "Blended $ / 1K tokens",
        "type": "textbox",
        "query": "0.0003",
        "current": { "text": "0.0003", "value": "0.0003" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs in progress",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 2 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "editorMode": "code", "expr": "sentinel_runs_in_progress", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Last run resilience %",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 50 }, { "color": "green", "value": 80 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [ { "refId": "A", "editorMode": "code", "expr": "sentinel_last_resilience_pct", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estimated LLM spend ($/hour)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "editorMode": "code", "expr": "sum(rate(sentinel_llm_tokens_total[5m])) * 3600 / 1000 * $price_per_1k", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Run rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "editorMode": "code", "legendFormat": "{{mode}} / {{status}}", "expr": "sum by (mode, status) (rate(sentinel_runs_total[5m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Run duration (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "editorMode": "code", "legendFormat": "p50 {{mode}}", "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(sentinel_run_duration_seconds_bucket[15m])))", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "editorMode": "code", "legendFormat": "p95 {{mode}}", "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(sentinel_run_duration_seconds_bucket[15m])))", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Per-node duration (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "editorMode": "code", "legendFormat": "{{node}}", "expr": "histogram_quantile(0.95, sum by (le, node) (rate(sentinel_node_duration_seconds_bucket[15m])))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Verdict breakdown (last 6h)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [ { "refId": "A", "editorMode": "code", "legendFormat": "{{verdict}}", "expr": "sum by (verdict) (increase(sentinel_verdicts_total[6h]))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM latency (p95)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "editorMode": "code", "legendFormat": "p95 {{model}}", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(sentinel_llm_request_seconds_bucket[10m])))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM request rate by outcome",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "editorMode": "code", "legendFormat": "{{outcome}}", "expr": "sum by (outcome) (rate(sentinel_llm_requests_total[5m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Token throughput",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [ { "refId": "A", "editorMode": "code", "legendFormat": "{{kind}} tok/s", "expr": "sum by (kind) (rate(sentinel_llm_tokens_total[5m]))", "datasource": { "type": "prometheus", "uid": "prometheus" } } ]
    }
  ]
}
